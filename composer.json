{
    "name": "spryker/content-banners-rest-api",
    "type": "library",
    "description": "ContentBannersRestApi module",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "spryker/content-banner": "^2.2.0",
        "spryker/glue-application": "^1.8.0",
        "spryker/glue-application-extension": "^1.0.0",
        "spryker/kernel": "^3.30.0",
        "spryker/symfony": "^3.0.0",
        "spryker/transfer": "^3.25.0"
    },
    "require-dev": {
        "spryker/api-platform": "*",
        "spryker/code-sniffer": "*"
    },
    "suggest": {
        "spryker/api-platform": "Required to expose API Platform resources."
    },
    "autoload": {
        "psr-4": {
            "Spryker\\": "src/Spryker/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
